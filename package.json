{
  "name": "@polyhymnia/musicxml-to-mnx",
  "version": "0.1.0",
  "description": "Offline MusicXML to MNX converter (library and CLI) with schema validation and stable element ids.",
  "keywords": [
    "musicxml",
    "mnx",
    "music",
    "converter",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "musicxml-to-mnx": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "convert": "node ./dist/cli.js"
  },
  "dependencies": {
    "@polyhymnia/mnx": "^0.1.0",
    "ajv": "8.20.0",
    "musicxml-to-mnx": "0.1.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "@types/node": "^26.6.2",
    "@changesets/cli": "^3.0.3"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/musicxml-to-mnx.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.2",
  "homepage": "https://github.com/adrian729/musicxml-to-mnx#readme",
  "bugs": {
    "url": "https://github.com/adrian729/musicxml-to-mnx/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
